#!/usr/bin/env bash
# Runs as root from greetd's ExecStartPre. Copies the selected user's visual
# state (wallpaper, palette, avatar, shell config, font) into a cache that the
# restricted greeter account can read.
#
# Every user-controlled path is read *as that user* (setpriv), so this script
# can never expose a file the user could not already open. Copies are also
# type-checked and size-capped, and the cache is readable by the greeter group
# only, so other local accounts cannot read the copies either.
set -euo pipefail

runtime_dir="${CAELESTIA_GREETER_RUNTIME_DIR:-/run/caelestia-greeter}"
cache_dir="${CAELESTIA_GREETER_CACHE_DIR:-/var/cache/caelestia-greeter}"
state_cache="$cache_dir/state"
profile_file="$runtime_dir/profile.env"
service_user="${CAELESTIA_GREETER_SERVICE_USER:-greeter}"
service_group="$(id -gn "$service_user")"

readonly MAX_IMAGE_BYTES=$((64 * 1024 * 1024))
readonly MAX_FONT_BYTES=$((32 * 1024 * 1024))
readonly MAX_JSON_BYTES=$((1024 * 1024))
readonly MAX_TEXT_BYTES=4096

log() {
    printf 'Caelestia Greeter profile-sync: %s\n' "$*" >&2
}

# root-owned, readable by the greeter group only.
own_for_greeter() {
    local mode="$1"
    shift
    if (( EUID == 0 )); then
        chown root:"$service_group" -- "$@"
    fi
    chmod "$mode" -- "$@"
}

secure_dir() {
    install -d -m 0750 -- "$1"
    own_for_greeter 0750 "$1"
}

secure_dir "$cache_dir"
secure_dir "$state_cache"
secure_dir "$state_cache/wallpaper"
install -d -m 0755 -- "$runtime_dir"
if (( EUID == 0 )); then
    install -d -m 0700 -o "$service_user" -g "$service_group" -- "$cache_dir/runtime-$service_user"
else
    install -d -m 0700 -- "$cache_dir/runtime-$service_user"
fi

detect_login_user() {
    local uid_min uid_max name password uid gid gecos home shell
    local selected="" selected_uid=""

    uid_min="$(awk '$1 == "UID_MIN" { print $2; exit }' /etc/login.defs 2>/dev/null || true)"
    uid_max="$(awk '$1 == "UID_MAX" { print $2; exit }' /etc/login.defs 2>/dev/null || true)"
    uid_min="${uid_min:-1000}"
    uid_max="${uid_max:-60000}"

    while IFS=: read -r name password uid gid gecos home shell; do
        [[ "$uid" =~ ^[0-9]+$ ]] || continue
        (( uid >= uid_min && uid <= uid_max )) || continue
        [[ "$name" != "nobody" && "$name" != "$service_user" ]] || continue
        [[ ! "$shell" =~ (nologin|false)$ ]] || continue

        if [[ -z "$selected" ]] || (( uid < selected_uid )); then
            selected="$name"
            selected_uid="$uid"
        fi
    done < <(getent passwd)

    printf '%s' "$selected"
}

trim() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

user="${CAELESTIA_GREETER_USER:-}"
if [[ -z "$user" || "$user" == "$service_user" || "$user" == "root" ]]; then
    user="$(detect_login_user)"
fi

if [[ -z "$user" ]]; then
    rm -f -- "$profile_file"
    log "no login user found."
    exit 0
fi

passwd_entry="$(getent passwd "$user" || true)"
if [[ -z "$passwd_entry" ]]; then
    rm -f -- "$profile_file"
    log "unknown user '$user'."
    exit 0
fi
IFS=: read -r _ _ user_uid user_gid gecos home_dir _ <<<"$passwd_entry"

if [[ "$user_uid" == 0 ]]; then
    rm -f -- "$profile_file"
    log "refusing to synchronise the root account."
    exit 0
fi

# Reads a file with the privileges of the target user and writes at most
# $2 + 1 bytes to stdout. Returns non-zero if the user cannot read the file.
read_as_user() {
    local source="$1" limit="$2"
    [[ "$source" == /* ]] || return 1

    if (( EUID == 0 )); then
        setpriv --reuid="$user_uid" --regid="$user_gid" --init-groups \
            --inh-caps=-all --no-new-privs \
            -- /usr/bin/head -c "$((limit + 1))" -- "$source" 2>/dev/null
    else
        /usr/bin/head -c "$((limit + 1))" -- "$source" 2>/dev/null
    fi
}

# extension_for KIND MIME SOURCE TMP_PATH
# Returns 0 if the mime type is acceptable for the asset kind and echoes the
# extension to use for the cached copy.
extension_for() {
    local kind="$1" mime="$2" source="$3" tmp_path="$4"
    case "$kind" in
        image)
            # The greeter process decodes these files. Only mature raster
            # decoders are allowed; SVG (XML + QtSvg), AVIF, GIF and BMP are
            # rejected on purpose, whatever the extension says.
            case "$mime" in
                image/png) printf png ;;
                image/jpeg) printf jpg ;;
                image/webp) printf webp ;;
                *) return 1 ;;
            esac
            ;;
        json)
            case "$mime" in
                application/json|text/plain|application/x-empty|inode/x-empty) printf json ;;
                *) return 1 ;;
            esac
            ;;
        font)
            # libmagic reports some variable fonts as octet-stream, so also
            # accept the sfnt magic numbers (TrueType, OpenType, TTC).
            case "$mime" in
                font/sfnt|font/ttf|font/otf|application/font-sfnt|application/x-font-ttf|application/x-font-otf|application/vnd.ms-opentype) printf ttf ;;
                application/octet-stream)
                    case "$(head -c 4 -- "$tmp_path" | od -An -tx1 | tr -d ' \n')" in
                        00010000|74727565|4f54544f|74746366) printf ttf ;;
                        *) return 1 ;;
                    esac
                    ;;
                *) return 1 ;;
            esac
            ;;
        *) return 1 ;;
    esac
}

max_bytes_for() {
    case "$1" in
        image) printf '%s' "$MAX_IMAGE_BYTES" ;;
        font) printf '%s' "$MAX_FONT_BYTES" ;;
        json) printf '%s' "$MAX_JSON_BYTES" ;;
        *) printf 0 ;;
    esac
}

# copy_asset SOURCE TARGET_BASE KIND [FIXED_NAME]
# Copies SOURCE (read as the target user) to TARGET_BASE.<ext>, or to
# TARGET_BASE/FIXED_NAME when a fixed file name is required. Prints the
# resulting path.
copy_asset() {
    local source="$1" target_base="$2" kind="$3" fixed_name="${4:-}"
    local limit size mime extension target tmp

    [[ -n "$source" && "$source" == /* ]] || return 1
    limit="$(max_bytes_for "$kind")"

    tmp="$(mktemp -- "$cache_dir/.asset.XXXXXX")"

    if ! read_as_user "$source" "$limit" >"$tmp"; then
        rm -f -- "$tmp"
        return 1
    fi

    size="$(stat -c %s -- "$tmp")"
    if (( size == 0 || size > limit )); then
        log "skipping '$source': empty or larger than $limit bytes."
        rm -f -- "$tmp"
        return 1
    fi

    mime="$(file --brief --mime-type -- "$tmp" 2>/dev/null || true)"
    if ! extension="$(extension_for "$kind" "$mime" "$source" "$tmp")"; then
        log "skipping '$source': unexpected type '$mime' for $kind."
        rm -f -- "$tmp"
        return 1
    fi

    if [[ -n "$fixed_name" ]]; then
        target="$target_base/$fixed_name"
    else
        target="$target_base.$extension"
        rm -f -- "$target_base" "$target_base".*
    fi

    own_for_greeter 0640 "$tmp"
    mv -f -- "$tmp" "$target"
    printf '%s' "$target"
}

accounts_file="/var/lib/AccountsService/users/$user"
real_name=""
icon=""
if [[ -r "$accounts_file" ]]; then
    real_name="$(awk -F= '$1 == "RealName" { print substr($0, index($0, "=") + 1); exit }' "$accounts_file")"
    icon="$(awk -F= '$1 == "Icon" { print substr($0, index($0, "=") + 1); exit }' "$accounts_file")"
fi

display_name="$(trim "$real_name")"
display_name="${display_name:-$(trim "${gecos%%,*}")}"
display_name="${display_name:-$user}"
display_name="${display_name//[$'\n\r']/ }"

avatar_cache=""
for candidate in \
    "$icon" \
    "/var/lib/AccountsService/icons/$user" \
    "$home_dir/.face.icon" \
    "$home_dir/.face"; do
    candidate="${candidate#file://}"
    if avatar_cache="$(copy_asset "$candidate" "$cache_dir/avatar-$user" image)"; then
        break
    fi
    avatar_cache=""
done

shell_config_source="${CAELESTIA_GREETER_SHELL_CONFIG_SOURCE:-$home_dir/.config/caelestia/shell.json}"
if ! shell_config_cache="$(copy_asset "$shell_config_source" "$cache_dir" json shell.json)"; then
    shell_config_cache=""
    rm -f -- "$cache_dir/shell.json"
fi

font_name="GoogleSansFlex-VariableFont_GRAD,ROND,opsz,slnt,wdth,wght.ttf"
font_source="${CAELESTIA_GREETER_GOOGLE_SANS_FLEX_SOURCE:-}"
font_cache=""
if [[ -z "$font_source" ]]; then
    for candidate in \
        "$home_dir/.config/quickshell/caelestia/assets/google-sans-flex/$font_name" \
        "/etc/xdg/quickshell/caelestia/assets/google-sans-flex/$font_name" \
        "/usr/share/quickshell/caelestia/assets/google-sans-flex/$font_name"; do
        if [[ -r "$candidate" && -f "$candidate" ]]; then
            font_source="$candidate"
            break
        fi
    done
fi
if [[ -n "$font_source" ]]; then
    if ! font_cache="$(copy_asset "$font_source" "$cache_dir" font "$font_name")"; then
        font_cache=""
    fi
fi
[[ -n "$font_cache" ]] || rm -f -- "$cache_dir/$font_name"

source_state="${CAELESTIA_GREETER_SOURCE_STATE_DIR:-$home_dir/.local/state/caelestia}"
scheme_source="${CAELESTIA_GREETER_SCHEME_SOURCE:-$source_state/scheme.json}"
if ! scheme_cache="$(copy_asset "$scheme_source" "$state_cache" json scheme.json)"; then
    scheme_cache=""
    rm -f -- "$state_cache/scheme.json"
fi

wallpaper_source="${CAELESTIA_GREETER_WALLPAPER_SOURCE:-}"
if [[ -z "$wallpaper_source" ]]; then
    wallpaper_source="$(read_as_user "$source_state/wallpaper/path.txt" "$MAX_TEXT_BYTES" | head -n 1 | tr -d '\r' || true)"
    wallpaper_source="$(trim "$wallpaper_source")"
fi

if wallpaper_cache="$(copy_asset "$wallpaper_source" "$cache_dir/wallpaper" image)"; then
    printf '%s\n' "$wallpaper_cache" >"$state_cache/wallpaper/path.txt.tmp"
    own_for_greeter 0640 "$state_cache/wallpaper/path.txt.tmp"
    mv -f -- "$state_cache/wallpaper/path.txt.tmp" "$state_cache/wallpaper/path.txt"
else
    wallpaper_cache=""
    rm -f -- "$state_cache/wallpaper/path.txt" "$cache_dir/wallpaper" "$cache_dir/wallpaper".*
fi

profile_tmp="$profile_file.tmp"
{
    printf 'CAELESTIA_GREETER_USER=%q\n' "$user"
    printf 'CAELESTIA_GREETER_DISPLAY_NAME=%q\n' "$display_name"
    printf 'CAELESTIA_GREETER_STATE_DIR=%q\n' "$state_cache"
    if [[ -n "$avatar_cache" ]]; then
        printf 'CAELESTIA_GREETER_AVATAR=%q\n' "$avatar_cache"
    fi
    if [[ -n "$shell_config_cache" ]]; then
        printf 'CAELESTIA_GREETER_SHELL_CONFIG_PATH=%q\n' "$shell_config_cache"
    fi
    if [[ -n "$font_cache" ]]; then
        printf 'CAELESTIA_GREETER_GOOGLE_SANS_FLEX_SOURCE=%q\n' "$font_cache"
    fi
    if [[ -n "$scheme_cache" ]]; then
        printf 'CAELESTIA_GREETER_SCHEME_PATH=%q\n' "$scheme_cache"
    fi
    if [[ -n "$wallpaper_cache" ]]; then
        printf 'CAELESTIA_GREETER_WALLPAPER=%q\n' "$wallpaper_cache"
    fi
} >"$profile_tmp"

own_for_greeter 0640 "$profile_tmp"
mv -f -- "$profile_tmp" "$profile_file"
